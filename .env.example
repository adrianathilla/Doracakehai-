# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ADMIN_PASSCODE: Optional server-side passcode for Portal Admin before Firebase Auth is connected.
# Leave empty to use the first-run Admin Setup form in the Portal Admin UI.
ADMIN_PASSCODE=""

# Firebase Web Configuration (Optional until ready to connect Cloud Firestore & Firebase Auth)
# VITE_FIREBASE_API_KEY=""
# VITE_FIREBASE_AUTH_DOMAIN=""
# VITE_FIREBASE_PROJECT_ID=""
# VITE_FIREBASE_STORAGE_BUCKET=""
# VITE_FIREBASE_MESSAGING_SENDER_ID=""
# VITE_FIREBASE_APP_ID=""
# VITE_FIREBASE_DATABASE_ID=""
